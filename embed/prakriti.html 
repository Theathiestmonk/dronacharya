<script>
// ─── CONFIG ───────────────────────────────────────────────────────────────
const APPS_SCRIPT_URL = 'https://script.google.com/macros/s/PASTE_DEPLOYMENT_ID/exec';
const RAZORPAY_KEY_ID = 'rzp_test_PASTE_YOUR_KEY_ID';

// Each programme has: name, campus, perWeek price, 3-week price, early-bird cutoff
const PRICES = {
  's22-3to5':   { name: 'Little Wonders (3–5) · Prakriti (Sec 22)',  campus: 'Sec 22',  1: 5500, 2: 11000, 3: 16500, cutoff: '2026-05-20T23:59:59+05:30' },
  's22-5to7':   { name: 'Big Adventurers (5–7) · Prakriti (Sec 22)', campus: 'Sec 22',  1: 6000, 2: 12000, 3: 18000, cutoff: '2026-05-20T23:59:59+05:30' },
  's128-3to5':  { name: 'Little Wonders (3–5) · Prakriti (Sec 128)', campus: 'Sec 128', 1: 6000, 2: 12000, 3: 18000, cutoff: '2026-05-15T23:59:59+05:30' },
  's128-6to10': { name: 'Big Explorers (6–10) · Prakriti (Sec 128)', campus: 'Sec 128', 1: 6500, 2: 13000, 3: 19500, cutoff: '2026-05-15T23:59:59+05:30' }
};

// Discount values are flat amounts, all stackable
const DISCOUNTS = { early: 1000, sibling: 1500, learner: 500 };

const $ = (id) => document.getElementById(id);
const backdrop = $('modal-backdrop');
const formView = $('form-view');
const successView = $('success-view');
const statusEl = $('form-status');

function fmtDate(iso) {
  return new Date(iso).toLocaleDateString('en-IN', { day:'numeric', month:'short', year:'numeric' });
}

function openModal(prog) {
  formView.style.display = 'block';
  successView.classList.remove('show');
  statusEl.className = 'form-status'; statusEl.textContent = '';
  if (prog && PRICES[prog]) {
    $('f-prog').value = prog;
    onProgChange();
  }
  backdrop.classList.add('show');
  document.body.style.overflow = 'hidden';
}
function closeModal() {
  backdrop.classList.remove('show');
  document.body.style.overflow = '';
  $('reg-form').reset();
  onProgChange();
  updateSummary();
}
document.querySelectorAll('[data-prog]').forEach(el => {
  el.addEventListener('click', (e) => { e.preventDefault(); openModal(el.dataset.prog); });
});
$('modal-close').addEventListener('click', closeModal);
backdrop.addEventListener('click', (e) => { if (e.target === backdrop) closeModal(); });

// Adjust form when programme changes (campus-specific UI bits)
function onProgChange() {
  const prog = $('f-prog').value;
  const p = PRICES[prog];

  // Transport field only relevant for Sec 22 (Sec 128 includes it)
  if (p && p.campus === 'Sec 22') {
    $('f-transport-wrap').classList.add('show');
    $('f-source-wrap').style.display = 'none';
  } else {
    $('f-transport-wrap').classList.remove('show');
    // when transport row is hidden, show source on its own line
    $('f-source-wrap').style.display = p ? 'grid' : 'none';
  }

  // Early-bird date note + auto-disable if past cutoff
  const earlyNote = $('disc-early-note');
  const earlyWrap = $('disc-early-wrap');
  const earlyChk = $('f-disc-early');
  if (p) {
    const cutoff = new Date(p.cutoff);
    const expired = new Date() > cutoff;
    earlyNote.textContent = '(valid till ' + fmtDate(p.cutoff) + ')';
    if (expired) {
      earlyChk.checked = false;
      earlyChk.disabled = true;
      earlyWrap.classList.add('disabled');
      earlyNote.textContent += ' — expired';
    } else {
      earlyChk.disabled = false;
      earlyWrap.classList.remove('disabled');
    }
  } else {
    earlyNote.textContent = '(valid till the cutoff date)';
  }
  updateSummary();
}

function getSelectedDiscounts() {
  const used = {};
  let amt = 0;
  if ($('f-disc-early').checked && !$('f-disc-early').disabled)  { used.early = DISCOUNTS.early;     amt += DISCOUNTS.early; }
  if ($('f-disc-sibling').checked) { used.sibling = DISCOUNTS.sibling; amt += DISCOUNTS.sibling; }
  if ($('f-disc-learner').checked) { used.learner = DISCOUNTS.learner; amt += DISCOUNTS.learner; }
  return { used, amt };
}

function calcAmount() {
  const prog = $('f-prog').value;
  const weeks = parseInt($('f-weeks').value, 10);
  if (!prog || !weeks || !PRICES[prog]) return { base:0, total:0, discount:0, used:{}, name:'', weeks:0 };
  const base = PRICES[prog][weeks];
  const d = getSelectedDiscounts();
  // discount cannot exceed base
  const discount = Math.min(d.amt, base);
  return { base, total: base - discount, discount, used:d.used, name: PRICES[prog].name, weeks };
}

function updateSummary() {
  const c = calcAmount();
  if (!c.total) {
    $('sum-amount').innerHTML = '₹ —';
    $('sum-meta').textContent = 'Choose programme & duration';
    $('sum-discount').textContent = '';
    return;
  }
  $('sum-amount').innerHTML = '₹' + c.total.toLocaleString('en-IN');
  $('sum-meta').textContent = c.name + ' · ' + c.weeks + ' week' + (c.weeks > 1 ? 's' : '');
  $('sum-discount').textContent = c.discount ? ' (saved ₹' + c.discount.toLocaleString('en-IN') + ')' : '';
}

$('f-prog').addEventListener('change', onProgChange);
$('f-weeks').addEventListener('change', updateSummary);
$('f-disc-early').addEventListener('change', updateSummary);
$('f-disc-sibling').addEventListener('change', updateSummary);
$('f-disc-learner').addEventListener('change', updateSummary);

function validate() {
  const required = ['f-prog','f-weeks','f-childName','f-childAge','f-childSchool','f-parentName','f-parentPhone','f-parentEmail','f-emergencyName','f-emergencyPhone'];
  for (const id of required) {
    const el = $(id);
    if (!el.value.trim()) { el.focus(); return 'Please fill in all required fields.'; }
  }
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test($('f-parentEmail').value)) { $('f-parentEmail').focus(); return 'Please enter a valid email address.'; }
  if ($('f-parentPhone').value.replace(/\s/g,'').length < 10) { $('f-parentPhone').focus(); return 'Please enter a valid phone number.'; }
  const age = parseInt($('f-childAge').value, 10);
  if (age < 3 || age > 11) { $('f-childAge').focus(); return 'Age should be between 3 and 11.'; }
  return null;
}
function showError(msg) { statusEl.className = 'form-status err'; statusEl.textContent = msg; statusEl.scrollIntoView({behavior:'smooth',block:'center'}); }
function showInfo(msg)  { statusEl.className = 'form-status info'; statusEl.textContent = msg; }

function collectFormData() {
  const p = PRICES[$('f-prog').value];
  const source = $('f-source-wrap').style.display === 'grid'
    ? $('f-source-alt').value
    : $('f-source').value;
  return {
    programme: $('f-prog').value,
    programmeName: p.name,
    campus: p.campus,
    weeks: parseInt($('f-weeks').value, 10),
    childName: $('f-childName').value.trim(),
    childAge: parseInt($('f-childAge').value, 10),
    childSchool: $('f-childSchool').value.trim(),
    parentName: $('f-parentName').value.trim(),
    parentPhone: $('f-parentPhone').value.trim(),
    parentEmail: $('f-parentEmail').value.trim(),
    emergencyName: $('f-emergencyName').value.trim(),
    emergencyPhone: $('f-emergencyPhone').value.trim(),
    medical: $('f-medical').value.trim(),
    transport: p.campus === 'Sec 22' ? $('f-transport').value : 'included',
    source: source,
    discounts: {
      early:   $('f-disc-early').checked   && !$('f-disc-early').disabled,
      sibling: $('f-disc-sibling').checked,
      learner: $('f-disc-learner').checked
    }
  };
}

$('reg-form').addEventListener('submit', async (e) => {
  e.preventDefault();
  const err = validate();
  if (err) return showError(err);

  const payBtn = $('pay-btn'), payLabel = $('pay-label');
  payBtn.disabled = true;
  payLabel.textContent = 'Creating booking…';
  showInfo('Setting up your booking — please wait…');

  const data = collectFormData();
  const calc = calcAmount();
  data.amount = calc.total;
  data.discount = calc.discount;

  try {
    const res = await fetch(APPS_SCRIPT_URL, {
      method: 'POST',
      headers: { 'Content-Type': 'text/plain;charset=utf-8' },
      body: JSON.stringify({ action: 'createOrder', payload: data })
    });
    const result = await res.json();
    if (!result.ok) throw new Error(result.error || 'Could not create booking.');

    statusEl.className = 'form-status'; statusEl.textContent = '';
    payLabel.textContent = 'Opening payment…';

    const rzp = new Razorpay({
      key: RAZORPAY_KEY_ID,
      amount: result.order.amount,
      currency: 'INR',
      name: 'Prakriti Summer Jamboree 2026',
      description: data.programmeName + ' · ' + data.weeks + ' week' + (data.weeks > 1 ? 's' : ''),
      order_id: result.order.id,
      prefill: { name: data.parentName, email: data.parentEmail, contact: data.parentPhone },
      notes: { bookingId: result.bookingId, childName: data.childName, campus: data.campus },
      theme: { color: '#E63946' },
      handler: async function (response) {
        payLabel.textContent = 'Verifying payment…';
        showInfo('Verifying payment, almost done…');
        try {
          const v = await fetch(APPS_SCRIPT_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'text/plain;charset=utf-8' },
            body: JSON.stringify({
              action: 'verifyPayment',
              payload: {
                bookingId: result.bookingId,
                razorpay_order_id: response.razorpay_order_id,
                razorpay_payment_id: response.razorpay_payment_id,
                razorpay_signature: response.razorpay_signature
              }
            })
          });
          const verify = await v.json();
          if (!verify.ok) throw new Error(verify.error || 'Verification failed');

          $('succ-email').textContent = data.parentEmail;
          $('succ-child').textContent = data.childName;
          $('succ-prog').textContent = data.programmeName + ' · ' + data.weeks + ' wk';
          $('succ-id').textContent = result.bookingId;
          $('succ-amt').textContent = '₹' + data.amount.toLocaleString('en-IN');
          formView.style.display = 'none';
          successView.classList.add('show');
        } catch (verErr) {
          showError('Payment received but verification failed. Please contact us with payment ID: ' + response.razorpay_payment_id);
          payBtn.disabled = false; payLabel.textContent = 'Pay & confirm seat';
        }
      },
      modal: {
        ondismiss: function() {
          payBtn.disabled = false; payLabel.textContent = 'Pay & confirm seat';
          statusEl.className = 'form-status info';
          statusEl.textContent = 'Payment cancelled. You can try again when you\'re ready.';
        }
      }
    });
    rzp.on('payment.failed', function (response) {
      showError('Payment failed: ' + (response.error?.description || 'Please try again.'));
      payBtn.disabled = false; payLabel.textContent = 'Pay & confirm seat';
    });
    rzp.open();

  } catch (e) {
    showError(e.message || 'Something went wrong. Please try again or WhatsApp us.');
    payBtn.disabled = false; payLabel.textContent = 'Pay & confirm seat';
  }
});
</script>
