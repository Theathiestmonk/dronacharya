
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Summer Jamboree 2026 · Prakriti School</title>
<meta name="description" content="A joyful summer at Prakriti — two campuses, two programmes. Prakriti (Sec 22) Slow Summers & Prakriti (Sec 128) Summer Jamboree. For ages 3 – 10. June 2026." />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,800;0,9..144,900;1,9..144,600&family=DM+Sans:wght@400;500;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>

<style>
  :root{
    --cream:#FBF3DD; --cream-2:#F5E8C2;
    --ink:#1B2B3A; --ink-soft:#2C3E50;
    --sun:#FFC93C; --mango:#FF7A2A; --watermelon:#E63946; --pink:#FF8FA3;
    --teal:#0F8B8D; --teal-deep:#0A5C5E; --leaf:#5A8F29; --plum:#5B2E91;
  }
  *{box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{margin:0;font-family:"DM Sans",system-ui,sans-serif;color:var(--ink);background:var(--cream);
    background-image:radial-gradient(circle at 18% 12%, rgba(255,201,60,.18), transparent 35%),radial-gradient(circle at 82% 28%, rgba(15,139,141,.10), transparent 40%),radial-gradient(circle at 50% 92%, rgba(230,57,70,.08), transparent 45%);
    line-height:1.5;overflow-x:hidden}
  body::before{content:"";position:fixed;inset:0;pointer-events:none;z-index:1;
    background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2' seed='4'/><feColorMatrix values='0 0 0 0 .11 0 0 0 0 .17 0 0 0 0 .23 0 0 0 .35 0'/></filter><rect width='100%' height='100%' filter='url(%23n)' opacity='.18'/></svg>");opacity:.4;mix-blend-mode:multiply}
  a{color:inherit;text-decoration:none}
  img{max-width:100%;display:block}

  .topbar{display:flex;align-items:center;justify-content:space-between;padding:22px 28px;max-width:1240px;margin:0 auto;position:relative;z-index:5}
  .brand{display:flex;align-items:center;gap:14px;font-family:"Fraunces",serif;font-weight:600;letter-spacing:-.01em}
  .brand-mark{width:42px;height:42px;border-radius:50%;background:var(--ink);color:var(--sun);display:grid;place-items:center;font-family:"Fraunces",serif;font-weight:800;font-size:22px;box-shadow:0 0 0 4px var(--cream),0 0 0 5px var(--ink)}
  .brand-name{font-size:18px}
  .brand-name small{display:block;font-family:"Space Mono",monospace;font-weight:400;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-soft);margin-top:2px}
  .topnav{display:flex;gap:28px;align-items:center;font-size:14px;font-weight:500}
  .topnav a{position:relative;padding:6px 0}
  .topnav a:hover{color:var(--watermelon)}
  .topnav a:hover::after{content:"";position:absolute;left:0;right:0;bottom:0;height:2px;background:var(--watermelon);border-radius:2px}
  .topnav .cta{background:var(--ink);color:var(--cream);padding:10px 18px;border-radius:999px;font-weight:700;transition:transform .2s ease,background .2s ease}
  .topnav .cta:hover{background:var(--watermelon);transform:translateY(-2px);color:var(--cream)}
  .topnav .cta:hover::after{display:none}

  .hero{padding:30px 28px 60px;max-width:1240px;margin:0 auto;position:relative;z-index:2}
  .eyebrow{display:inline-flex;align-items:center;gap:10px;font-family:"Space Mono",monospace;font-size:12px;letter-spacing:.18em;text-transform:uppercase;color:var(--teal-deep);background:rgba(15,139,141,.12);padding:8px 14px;border-radius:999px;border:1px dashed var(--teal)}
  .eyebrow .dot{width:8px;height:8px;border-radius:50%;background:var(--watermelon);box-shadow:0 0 0 4px rgba(230,57,70,.18)}
  h1.hero-title{font-family:"Fraunces",serif;font-weight:900;font-size:clamp(52px,10vw,140px);line-height:.92;letter-spacing:-.035em;margin:22px 0 18px;color:var(--ink)}
  h1.hero-title em{font-style:italic;font-weight:600;color:var(--watermelon);font-family:"Fraunces",serif}
  h1.hero-title .pop{color:var(--sun);-webkit-text-stroke:2px var(--ink);text-shadow:6px 6px 0 var(--teal)}
  .hero-grid{display:grid;grid-template-columns:1.3fr .9fr;gap:60px;align-items:start;margin-top:14px}
  .hero-lede{font-family:"Fraunces",serif;font-size:22px;line-height:1.4;font-weight:400;max-width:540px;color:var(--ink-soft)}
  .hero-lede strong{color:var(--ink);font-weight:600}
  .hero-cta{margin-top:30px;display:flex;gap:14px;flex-wrap:wrap}
  .btn{display:inline-flex;align-items:center;gap:10px;padding:16px 26px;border-radius:999px;font-family:"DM Sans",sans-serif;font-weight:700;font-size:15px;letter-spacing:.01em;border:none;cursor:pointer;transition:transform .2s ease,box-shadow .2s ease,background .2s ease}
  .btn-primary{background:var(--ink);color:var(--cream);box-shadow:4px 4px 0 var(--sun)}
  .btn-primary:hover{transform:translate(-2px,-2px);box-shadow:6px 6px 0 var(--watermelon)}
  .btn-primary:disabled{opacity:.5;cursor:not-allowed;transform:none;box-shadow:4px 4px 0 var(--sun)}
  .btn-ghost{background:transparent;color:var(--ink);border:1.5px solid var(--ink)}
  .btn-ghost:hover{background:var(--ink);color:var(--cream)}

  .collage{position:relative;aspect-ratio:1/1.05;min-height:380px}
  .sticker{position:absolute;transform-origin:center;filter:drop-shadow(0 8px 14px rgba(27,43,58,.18))}
  .sticker.s1{top:0;left:6%;width:62%;animation:float 6s ease-in-out infinite}
  .sticker.s2{top:18%;right:0;width:42%;animation:float 7s ease-in-out infinite;animation-delay:-2s}
  .sticker.s3{bottom:8%;left:18%;width:48%;animation:float 8s ease-in-out infinite;animation-delay:-1s}
  .sticker.s4{bottom:0;right:8%;width:32%;animation:float 6.5s ease-in-out infinite;animation-delay:-3s}
  @keyframes float{0%,100%{transform:translateY(0) rotate(var(--r,0deg))}50%{transform:translateY(-12px) rotate(calc(var(--r,0deg) + 1.5deg))}}
  .deco{position:absolute;pointer-events:none;z-index:1}
  .deco.sun-lg{top:80px;right:-60px;width:200px;animation:spin 40s linear infinite}
  @keyframes spin{to{transform:rotate(360deg)}}

  /* ——— campus banner row ——— */
  .campus-row{
    max-width:1240px;margin:0 auto 80px;padding:0 28px;
    display:grid;grid-template-columns:1fr 1fr;gap:22px;
    position:relative;z-index:2;
  }
  .campus-tag{
    background:#fff;border:1.5px solid var(--ink);
    border-radius:22px;padding:22px 26px;
    box-shadow:6px 6px 0 var(--ink);
    display:flex;flex-direction:column;gap:6px;
    transition:transform .25s ease;
  }
  .campus-tag:hover{transform:translate(-3px,-3px);box-shadow:9px 9px 0 var(--ink)}
  .campus-tag .ct-eyebrow{font-family:"Space Mono",monospace;font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-soft)}
  .campus-tag .ct-name{font-family:"Fraunces",serif;font-weight:800;font-size:28px;line-height:1;letter-spacing:-.015em;margin:4px 0 8px}
  .campus-tag .ct-name em{font-style:italic;font-weight:500;color:var(--watermelon)}
  .campus-tag .ct-meta{font-family:"Space Mono",monospace;font-size:12px;color:var(--ink-soft);letter-spacing:.05em;line-height:1.6}
  .campus-tag.sec22{border-left:6px solid var(--teal)}
  .campus-tag.sec128{border-left:6px solid var(--mango)}

  .marquee{background:var(--ink);color:var(--cream);padding:18px 0;overflow:hidden;position:relative;z-index:3;border-top:1px solid var(--ink-soft);border-bottom:1px solid var(--ink-soft)}
  .marquee-track{display:flex;gap:60px;white-space:nowrap;animation:scroll 28s linear infinite;font-family:"Fraunces",serif;font-size:32px;font-weight:600;font-style:italic}
  .marquee-track span{display:inline-flex;align-items:center;gap:60px}
  .marquee-track span::after{content:"✺";color:var(--sun);font-style:normal;font-size:24px}
  @keyframes scroll{from{transform:translateX(0)}to{transform:translateX(-50%)}}

  section{position:relative;z-index:2}
  .section-head{display:grid;grid-template-columns:auto 1fr;align-items:end;gap:32px;margin-bottom:48px}
  .section-num{font-family:"Space Mono",monospace;font-size:13px;letter-spacing:.18em;color:var(--watermelon);text-transform:uppercase;border-top:2px solid var(--watermelon);padding-top:10px}
  .section-title{font-family:"Fraunces",serif;font-weight:800;font-size:clamp(40px,6vw,72px);line-height:.95;letter-spacing:-.025em;margin:0}
  .section-title em{font-weight:500;font-style:italic;color:var(--teal-deep)}

  /* ——— campuses (side-by-side spine) ——— */
  .campuses{padding:100px 28px 60px;max-width:1240px;margin:0 auto}
  .duo{display:grid;grid-template-columns:1fr 1fr;gap:26px}
  .col-hdr{
    padding:24px 26px 20px;
    border-radius:22px 22px 0 0;
    color:var(--cream);
    position:relative;
  }
  .col-hdr.s22{background:var(--teal-deep)}
  .col-hdr.s128{background:var(--mango)}
  .col-hdr h3{font-family:"Fraunces",serif;font-weight:800;font-size:36px;line-height:1;letter-spacing:-.02em;margin:0 0 4px}
  .col-hdr h3 em{font-style:italic;font-weight:500}
  .col-hdr .sub{font-family:"Space Mono",monospace;font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;opacity:.85}
  .col-hdr .pin{
    position:absolute;top:24px;right:26px;
    background:var(--cream);color:var(--ink);
    font-family:"Space Mono",monospace;font-size:11px;font-weight:700;
    padding:6px 12px;border-radius:999px;letter-spacing:.1em;
  }

  .group{
    background:#fff;
    border:1.5px solid var(--ink); border-top:none;
    padding:26px 26px 24px;
    position:relative;
  }
  .group + .group{border-radius:0}
  .group:last-of-type{border-radius:0 0 22px 22px}
  .group-eyebrow{
    display:inline-flex;align-items:center;gap:8px;
    font-family:"Space Mono",monospace;font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;
    color:var(--watermelon);
    margin-bottom:10px;
  }
  .group-eyebrow::before{content:"";width:10px;height:10px;border-radius:50%;background:var(--watermelon)}
  .group-name{
    font-family:"Fraunces",serif;font-weight:800;font-size:30px;line-height:1.05;letter-spacing:-.02em;margin:0 0 14px;
  }
  .group-name em{color:var(--ink-soft);font-style:italic;font-weight:500;font-size:18px;display:block;letter-spacing:-.01em;margin-top:2px}
  .activity-list{list-style:none;padding:0;margin:0 0 18px;display:grid;grid-template-columns:1fr 1fr;gap:6px 14px}
  .activity-list li{font-size:14px;line-height:1.4;display:flex;flex-direction:column;padding:6px 0}
  .activity-list li b{font-weight:600;color:var(--ink)}
  .activity-list li small{font-family:"Space Mono",monospace;font-size:10.5px;color:var(--ink-soft);letter-spacing:.04em;margin-top:2px}
  .price-row{
    display:flex;gap:10px;
    margin:14px 0 12px;
  }
  .price-chip{
    flex:1;
    background:var(--cream);
    border:1.5px solid var(--ink);
    border-radius:14px;
    padding:12px 14px;
    text-align:center;
  }
  .price-chip .lbl{font-family:"Space Mono",monospace;font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-soft)}
  .price-chip .val{font-family:"Fraunces",serif;font-size:24px;font-weight:800;line-height:1;margin-top:2px}
  .price-chip.savings{background:var(--sun);border-color:var(--ink)}
  .discounts{
    display:flex;flex-wrap:wrap;gap:6px;margin-bottom:16px;
  }
  .disc-pill{
    font-family:"Space Mono",monospace;font-size:11px;
    background:rgba(15,139,141,.12);color:var(--teal-deep);
    border:1px dashed var(--teal);
    padding:5px 10px;border-radius:999px;
    letter-spacing:.04em;
  }
  .disc-pill b{color:var(--ink)}
  .group-cta{
    display:flex;align-items:center;justify-content:center;gap:8px;width:100%;padding:13px;
    background:var(--ink);color:var(--cream);border-radius:14px;font-weight:700;font-size:14.5px;
    transition:background .2s ease;cursor:pointer;border:none;font-family:inherit;
  }
  .group-cta:hover{background:var(--watermelon)}
  .group-cta.s22:hover{background:var(--teal-deep)}
  .group-cta.s128:hover{background:var(--mango)}

  /* shared comforts + game plan strip */
  .strip{
    margin-top:48px;
    background:var(--ink);color:var(--cream);
    border-radius:24px;
    padding:36px 38px;
    display:grid;grid-template-columns:1fr 1fr;gap:48px;
  }
  .strip h3{font-family:"Fraunces",serif;font-weight:800;font-size:28px;letter-spacing:-.02em;margin:0 0 16px}
  .strip h3 em{color:var(--sun);font-style:italic;font-weight:500}
  .strip ul{list-style:none;padding:0;margin:0;font-size:14.5px;line-height:1.9}
  .strip ul li{display:flex;gap:14px;align-items:baseline}
  .strip ul li .time{font-family:"Space Mono",monospace;font-size:12px;color:var(--sun);letter-spacing:.04em;min-width:120px}
  .strip ul li b{font-weight:600}
  .strip .note{margin-top:14px;font-family:"Space Mono",monospace;font-size:11.5px;color:rgba(251,243,221,.65);letter-spacing:.05em}
  .strip-comforts li{display:flex;gap:12px;align-items:center;padding:5px 0}
  .strip-comforts li .ic{width:30px;height:30px;border-radius:50%;background:var(--sun);color:var(--ink);display:grid;place-items:center;font-size:16px;flex-shrink:0}
  .strip-comforts li b{display:block;font-weight:600}
  .strip-comforts li small{font-family:"Space Mono",monospace;font-size:11px;color:rgba(251,243,221,.65);display:block;letter-spacing:.04em;margin-top:2px}

  /* ——— how it works ——— */
  .how{padding:90px 28px;max-width:1240px;margin:0 auto}
  .how-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:32px;margin-top:32px}
  .step{padding:28px 24px;border-radius:20px;background:rgba(255,255,255,.5);border:1px solid rgba(27,43,58,.15);backdrop-filter:blur(2px);position:relative}
  .step-num{position:absolute;top:-22px;left:24px;width:44px;height:44px;border-radius:50%;background:var(--watermelon);color:#fff;font-family:"Fraunces",serif;font-weight:800;font-size:22px;display:grid;place-items:center;border:2px solid var(--ink);box-shadow:3px 3px 0 var(--ink)}
  .step:nth-child(2) .step-num{background:var(--teal)}
  .step:nth-child(3) .step-num{background:var(--mango)}
  .step h3{font-family:"Fraunces",serif;font-weight:700;font-size:22px;margin:14px 0 8px}
  .step p{font-size:14.5px;color:var(--ink-soft);margin:0}

  .faq{padding:80px 28px;max-width:1240px;margin:0 auto}
  .faq-list{margin-top:32px}
  details{border-top:1.5px solid var(--ink);padding:22px 4px;cursor:pointer}
  details:last-child{border-bottom:1.5px solid var(--ink)}
  summary{list-style:none;display:flex;justify-content:space-between;align-items:center;gap:24px;font-family:"Fraunces",serif;font-weight:600;font-size:22px;line-height:1.3;color:var(--ink)}
  summary::-webkit-details-marker{display:none}
  summary::after{content:"+";font-family:"Fraunces",serif;font-size:32px;font-weight:400;width:40px;height:40px;border:1.5px solid var(--ink);border-radius:50%;display:grid;place-items:center;flex-shrink:0;transition:transform .25s ease,background .2s ease,color .2s ease}
  details[open] summary::after{transform:rotate(45deg);background:var(--ink);color:var(--cream)}
  details p{margin:14px 0 0;font-size:15.5px;color:var(--ink-soft);max-width:760px;line-height:1.6}

  .cta-banner{margin:80px 28px 0;max-width:1240px;margin-left:auto;margin-right:auto;background:var(--ink);color:var(--cream);border-radius:32px;padding:80px 60px;position:relative;overflow:hidden}
  .cta-banner h2{font-family:"Fraunces",serif;font-weight:800;font-size:clamp(40px,6vw,76px);line-height:.95;letter-spacing:-.03em;margin:0 0 18px;max-width:760px}
  .cta-banner h2 em{color:var(--sun);font-style:italic;font-weight:500}
  .cta-banner p{font-size:18px;max-width:540px;color:#E8DCC0;margin:0 0 28px}
  .cta-banner .btn-primary{background:var(--sun);color:var(--ink);box-shadow:4px 4px 0 var(--watermelon)}
  .cta-banner .btn-primary:hover{box-shadow:6px 6px 0 var(--cream)}
  .cta-banner .btn-ghost{border-color:var(--cream);color:var(--cream)}
  .cta-banner .btn-ghost:hover{background:var(--cream);color:var(--ink)}
  .cta-deco{position:absolute;right:-60px;bottom:-60px;width:280px;opacity:.9}

  footer{padding:60px 28px 36px;max-width:1240px;margin:0 auto;display:grid;grid-template-columns:1.5fr 1fr 1fr 1fr;gap:40px;border-top:1px solid rgba(27,43,58,.2);margin-top:80px}
  footer h4{font-family:"Space Mono",monospace;font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-soft);margin:0 0 14px}
  footer ul{list-style:none;padding:0;margin:0;font-size:14.5px;line-height:2}
  footer ul a:hover{color:var(--watermelon)}
  .foot-brand p{margin:14px 0 0;color:var(--ink-soft);font-size:14px;max-width:280px}
  .foot-bottom{grid-column:1/-1;display:flex;justify-content:space-between;align-items:center;padding-top:24px;border-top:1px dashed rgba(27,43,58,.25);font-family:"Space Mono",monospace;font-size:11.5px;color:var(--ink-soft);letter-spacing:.06em}
  .socials{display:flex;gap:10px}
  .socials a{width:36px;height:36px;border-radius:50%;border:1.5px solid var(--ink);display:grid;place-items:center;transition:background .2s ease,color .2s ease}
  .socials a:hover{background:var(--ink);color:var(--cream)}

  .reveal{opacity:0;transform:translateY(20px);animation:rise .8s ease forwards}
  .reveal.d1{animation-delay:.1s}.reveal.d2{animation-delay:.25s}.reveal.d3{animation-delay:.4s}.reveal.d4{animation-delay:.55s}
  @keyframes rise{to{opacity:1;transform:translateY(0)}}

  /* ——— registration modal ——— */
  .modal-backdrop{position:fixed;inset:0;z-index:100;background:rgba(27,43,58,.55);backdrop-filter:blur(6px);display:none;align-items:flex-start;justify-content:center;padding:40px 20px;overflow-y:auto}
  .modal-backdrop.show{display:flex;animation:fadeIn .3s ease}
  @keyframes fadeIn{from{opacity:0}to{opacity:1}}
  .modal{background:var(--cream);border:1.5px solid var(--ink);border-radius:28px;width:100%;max-width:680px;padding:36px 40px 32px;position:relative;box-shadow:10px 10px 0 var(--ink);animation:slideUp .35s cubic-bezier(.2,.8,.2,1)}
  @keyframes slideUp{from{transform:translateY(20px);opacity:0}to{transform:translateY(0);opacity:1}}
  .modal-close{position:absolute;top:18px;right:18px;width:38px;height:38px;border-radius:50%;background:var(--cream);border:1.5px solid var(--ink);font-size:20px;font-family:"Fraunces",serif;display:grid;place-items:center;cursor:pointer;transition:background .2s ease,color .2s ease,transform .2s ease}
  .modal-close:hover{background:var(--ink);color:var(--cream);transform:rotate(90deg)}
  .modal h3{font-family:"Fraunces",serif;font-weight:800;font-size:36px;line-height:1;letter-spacing:-.02em;margin:0 0 6px}
  .modal-sub{font-family:"Space Mono",monospace;font-size:12px;color:var(--ink-soft);letter-spacing:.08em;text-transform:uppercase;margin:0 0 24px}
  .form-row{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px}
  .form-row.full{grid-template-columns:1fr}
  .form-field label{display:block;font-family:"Space Mono",monospace;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-soft);margin-bottom:6px;font-weight:700}
  .form-field label .req{color:var(--watermelon)}
  .form-field input,.form-field select,.form-field textarea{width:100%;padding:12px 14px;border:1.5px solid var(--ink);border-radius:12px;background:#fff;font-family:"DM Sans",sans-serif;font-size:15px;color:var(--ink);transition:border-color .2s ease,box-shadow .2s ease}
  .form-field input:focus,.form-field select:focus,.form-field textarea:focus{outline:none;border-color:var(--watermelon);box-shadow:0 0 0 3px rgba(230,57,70,.18)}
  .form-field textarea{resize:vertical;min-height:64px;font-family:"DM Sans",sans-serif}
  .form-field small{display:block;margin-top:5px;font-family:"Space Mono",monospace;font-size:11px;color:var(--ink-soft)}
  .checkbox-row{display:flex;flex-direction:column;gap:8px;margin-bottom:14px}
  .check-item{display:flex;gap:10px;align-items:center;padding:10px 14px;background:#fff;border:1.5px solid var(--ink);border-radius:12px;cursor:pointer;transition:background .2s ease}
  .check-item:hover{background:var(--cream-2)}
  .check-item input{width:auto;margin:0;cursor:pointer;accent-color:var(--watermelon)}
  .check-item label{display:flex;flex:1;justify-content:space-between;align-items:center;cursor:pointer;font-family:"DM Sans",sans-serif;font-size:14px;color:var(--ink);text-transform:none;letter-spacing:0;font-weight:500;margin:0}
